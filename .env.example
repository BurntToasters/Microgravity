# Copy to .env for local overrides. Shell environment variables take precedence.
# Never commit .env or put signing material in this template.

# Set this value from the public half of the Sparkle key generated for this app.
# Release preflight blocks without it; automatic update checks stay disabled until set.
MICROGRAVITY_SPARKLE_PUBLIC_KEY=

# Configure exactly one EdDSA signing source for Sparkle release archives.
MICROGRAVITY_SPARKLE_ACCOUNT=
MICROGRAVITY_SPARKLE_PRIVATE_KEY_FILE=
# Optional direct key material; keep it only in ignored .env or a secure shell environment.
MICROGRAVITY_SPARKLE_PRIVATE_KEY=

# Apple Developer ID signing and notarization configuration.
MICROGRAVITY_SIGNING_IDENTITY=
MICROGRAVITY_TEAM_ID=
MICROGRAVITY_NOTARY_PROFILE=

# GPG release signatures. Prefer gpg-agent; passphrase is optional.
MICROGRAVITY_GPG_KEY=
MICROGRAVITY_GPG_PASSPHRASE=

# GitHub releases use the GitHub CLI credential store (`gh auth login`).
# No GitHub access token belongs in this file.

# Release prepare skips the UI automation suite (MicrogravityUITests). Set to 1 to include it in a release run.
MICROGRAVITY_RELEASE_UI_TESTS=
